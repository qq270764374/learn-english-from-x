# 默认使用 DeepSeek（OpenAI 兼容格式，性价比高）
LLM_PROVIDER=openai_compatible
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 若改用 Google Gemini，请将上面 LLM_PROVIDER 设为 gemini 并填写下方密钥
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 过滤级别：strict_1200 | basic_2000（默认） | cet4_3500
DEFAULT_FILTER_TIER=basic_2000
HOST=127.0.0.1
PORT=8765

# 可选：本机 Obsidian Vault 目录路径（也可直接在网页“设置”中填写）
OBSIDIAN_VAULT_DIR=
OBSIDIAN_SUBFOLDER=X-Vocab

